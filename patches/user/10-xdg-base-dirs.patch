+// XDG Base Directory helpers: per spec, relative values must be ignored.
+function xdgDir(envName: string, homeDir: string, fallback: string): string {
+	const value = env[envName];
+	return value && value.startsWith('/') ? value : join(homeDir, fallback);
+}
+
+export function getXdgConfigDir(homeDir: string, productName: string): string {
+	return join(xdgDir('XDG_CONFIG_HOME', homeDir, '.config'), productName);
+}
+
+export function getXdgDataDir(homeDir: string, productName: string): string {
+	return join(xdgDir('XDG_DATA_HOME', homeDir, '.local/share'), productName);
+}
+
+export function getXdgStateDir(homeDir: string, productName: string): string {
+	return join(xdgDir('XDG_STATE_HOME', homeDir, '.local/state'), productName);
+}
