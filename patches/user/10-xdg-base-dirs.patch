+/// XDG: default CLI data root is `$XDG_DATA_HOME/<product>/cli` (relative values are ignored).
+fn default_cli_root() -> Option<PathBuf> {
+	let base = match std::env::var_os("XDG_DATA_HOME") {
+		Some(v) if Path::new(&v).is_absolute() => PathBuf::from(v),
+		_ => dirs::home_dir()?.join(".local").join("share"),
+	};
+	Some(base.join(PRODUCT_NAME_SHORT).join("cli"))
+}
