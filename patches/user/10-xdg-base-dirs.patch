+/**
+ * Sandbox temp dir for the local machine, following the XDG base directory spec
+ * ($XDG_STATE_HOME/<productName>/tmp).
+ */
+export function getLocalSandboxTempDir(userHome: URI, productName: string, windowId?: number): URI {
+	const sandboxRoot = URI.joinPath(URI.file(getXdgStateDir(userHome.fsPath, productName)), 'tmp');
+	return typeof windowId === 'number' ? URI.joinPath(sandboxRoot, `tmp_vscode_${windowId}`) : sandboxRoot;
+}
